# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# --- Database (Phase 7: PostgreSQL + pgvector is REQUIRED) ---
# Local development needs no Docker: start the bundled cluster first
#     python scripts/dev_db.py start
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:54329/vilasat

# --- Embeddings (Phase 7) ---
# Provider selection: "nvidia" = real OpenAI-compatible endpoint;
# "fake" = deterministic TEST provider, rejected unless ENVIRONMENT=testing.
# The in-app Demo switch is a separate explicit local mode (production off).
EMBEDDING_PROVIDER=nvidia
# Original choice (nvidia/nv-embedqa-e5-v5) reached EOL on NVIDIA's API
# (HTTP 410, verified 2026-11-10); replacement verified live, 2048 dims.
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
# Real embeddings (indexing + retrieval) require this key; without it both
# fail loudly instead of serving fake vectors. Never commit a real key.
EMBEDDING_API_KEY=
# Role prefixes for models that need them (E5 family). nemotron-3-embed-1b
# is symmetric and needs NONE — both stay empty. Quoted so values survive
# dotenv parsing.
EMBEDDING_QUERY_PREFIX=""
EMBEDDING_PASSAGE_PREFIX=""
# Must match the pgvector schema column: vector(2048).
EMBEDDING_DIMENSIONS=2048
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=16

# --- Retrieval (Phase 7) ---
# Retrieval returns possible evidence only; it never decides sufficiency.
RETRIEVAL_TOP_K_DEFAULT=5
RETRIEVAL_TOP_K_MAX=20
RETRIEVAL_MAX_QUERY_CHARS=2000
# E5 cosine similarities cluster around 0.7-1.0, so 0.0 (no cutoff) is the
# honest default; a non-zero value only trims obviously irrelevant results.
RETRIEVAL_MIN_COSINE_SIMILARITY=0.0

# --- CORS (comma-separated explicit origins; wildcards are rejected) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LLM / Agent core (Phase 8A) ---
# Provider selection: "nvidia" (default) = real OpenAI-compatible chat
# endpoint (needs NVIDIA_API_KEY); "stub" = deterministic TEST generator,
# reachable only when ENVIRONMENT=testing. The in-app Demo switch is a
# separate explicit local mode (refused when ENVIRONMENT=production).
# The LLM provider and the embedding provider above are SEPARATE logical
# components — either can move to another provider without the other.
LLM_PROVIDER=nvidia
# Model note: verified working with the strict-JSON generation contract.
# Known-bad ids (do not use): deepseek-ai/deepseek-v4.1-flash (listed by
# /models but inference hangs indefinitely, verified 2026-11-10);
# meta/llama-3.3-70b-instruct (EOL, HTTP 410);
# nvidia/nemotron-3.5-super-vl-120b-a12b (works but non-deterministic at
# temperature 0.0 — a reasoning model samples its chain-of-thought).
# Any OpenAI-compatible chat model id works with the nvidia provider.
LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# May equal EMBEDDING_API_KEY when the NVIDIA account serves both services,
# but each component reads the key independently. Never commit a real key.
NVIDIA_API_KEY=
LLM_TIMEOUT_SECONDS=60
# Grounded structured output wants determinism (range 0-1).
LLM_TEMPERATURE=0.0
# Endpoint caps max_tokens at 4096; config validation enforces [1, 4096].
# Use the FULL budget when the model is a reasoning model: its
# reasoning_tokens count against this cap, and a too-small value truncates
# real answers (surfaced as "LLM response was truncated").
LLM_MAX_COMPLETION_TOKENS=4096
# Controlled evidence sent to the model per turn (§9): item count (default
# matches retrieval top-k) and per-item character cap keep prompts bounded.
LLM_MAX_EVIDENCE=5
LLM_EVIDENCE_MAX_CHARS=1200

# --- Agent decision layer (Phase 8B) ---
# Deterministic gates the APPLICATION enforces around the LLM (they can
# only make decisions MORE conservative; the model never overrides them).
# Relevance: best retrieved candidate's cosine similarity must reach this
# bar. Permissive by design for live embeddings: nemotron-3-embed-1b
# scores on-topic AND unrelated pairs high, so the cosine bar alone
# cannot separate them — the coverage gate below and the support check
# carry the protection. Re-tune from a labelled live evaluation set.
AGENT_MIN_EVIDENCE_RELEVANCE=0.05
# Coverage: fraction of the question's material words that must appear in
# the retrieved evidence (0.75 = conservative; below it the agent says so
# instead of guessing).
AGENT_MIN_COVERAGE_RATIO=0.75
# Bounded conversation context per turn: last N messages, each truncated
# to this many characters (the full history never reaches a prompt).
AGENT_CONTEXT_MAX_MESSAGES=6
AGENT_CONTEXT_MAX_CHARS=500
